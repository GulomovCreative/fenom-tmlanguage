{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Fenom",
  "scopeName": "text.html.fenom",
  "fileTypes": ["tpl"],
  "injections": {
    "L:text.html.fenom -meta.embedded.literal -comment.block.fenom": {
      "patterns": [
        {
          "include": "#nonFenom"
        },
        {
          "include": "#ignore"
        },
        {
          "include": "#comments"
        },
        {
          "include": "#blocks"
        }
      ]
    }
  },
  "patterns": [
    { "include": "text.html.derivative" }
  ],
  "repository": {
    "nonFenom": {
      "patterns": [
        {
          "comment": "A brace is literal text when the next character is whitespace or a closing brace: Fenom's lexer checks for exactly \\n, \\r, \\t, space and } before treating a brace as the start of a tag.",
          "match": "(\\{%?)[\\s}]"
        }
      ]
    },
    "ignore": {
      "comment": "Everything between {ignore} and {/ignore} is emitted verbatim, so Fenom syntax inside it must not be highlighted. The content is scoped meta.embedded.literal, which this grammar's injection selector already excludes, so the injection stops applying inside the block while the host HTML grammar keeps working. Comments are the one exception: Fenom's lexer handles {* *} before it consults the ignore flag, so they are still stripped inside an ignore block and are still highlighted here.",
      "begin": "(\\{)(ignore)(\\})",
      "beginCaptures": {
        "1": { "name": "punctuation.section.embedded.begin.fenom" },
        "2": { "name": "keyword.control.fenom" },
        "3": { "name": "punctuation.section.embedded.end.fenom" }
      },
      "end": "(\\{)(/)(ignore)(\\})",
      "endCaptures": {
        "1": { "name": "punctuation.section.embedded.begin.fenom" },
        "2": { "name": "punctuation.definition.tag.fenom" },
        "3": { "name": "keyword.control.fenom" },
        "4": { "name": "punctuation.section.embedded.end.fenom" }
      },
      "contentName": "meta.embedded.literal.fenom",
      "patterns": [
        {
          "include": "#comments"
        }
      ]
    },
    "comments": {
      "begin": "{{?\\*",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.comment.begin.fenom" }
      },
      "name": "comment.block.fenom",
      "end": "\\*}}?",
      "endCaptures": {
        "0": { "name": "punctuation.definition.comment.end.fenom" }
      },
      "patterns": [
        {
          "match": "{{?\\*",
          "name": "invalid.illegal.characters-not-allowed-here.fenom"
        }
      ]
    },
    "blocks": {
      "patterns": [
        {
          "begin": "(\\{%?)",
          "beginCaptures": {
            "1": {
                "name": "punctuation.section.embedded.begin.fenom"
            }
          },
          "end": "(%?\\})",
          "endCaptures": {
            "1": {
                "name": "punctuation.section.embedded.end.fenom"
            }
          },
          "name": "source.fenom",
          "patterns": [
            {
              "include": "#strings"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#variables"
            },
            {
              "include": "#lang"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b0[xX][0-9a-fA-F]+\\b",
          "name": "constant.numeric.hex.fenom"
        },
        {
          "match": "\\b0[bB][01]+\\b",
          "name": "constant.numeric.binary.fenom"
        },
        {
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b|\\b\\d+[eE][+-]?\\d+\\b",
          "name": "constant.numeric.float.fenom"
        },
        {
          "match": "\\b0[0-7]+\\b",
          "name": "constant.numeric.octal.fenom"
        },
        {
          "match": "\\b\\d+\\b",
          "name": "constant.numeric.decimal.fenom"
        }
      ]
    },
    "lang": {
      "patterns": [
        {
          "comment": "Modifiers are matched before the operators so the leading pipe is read as a modifier separator rather than as bitwise or.",
          "captures": {
            "1": {
              "name": "keyword.operator.fenom"
            },
            "2": {
              "name": "entity.name.function.fenom"
            }
          },
          "match": "(\\|)\\s*([a-zA-Z_]+)\\b"
        },
        {
          "comment": "The slash opening a closing tag, as in {/if}. Matched before the operators so it is not read as division.",
          "match": "(?<=\\{)/",
          "name": "punctuation.definition.tag.fenom"
        },
        {
          "comment": "Alternatives are ordered longest first -- all three-character operators, then all two-character, then all one-character -- so that === is one token rather than three, and <<= is not split into << and =. Operators of equal length cannot be prefixes of one another, so their relative order is free, which is what lets each length band be split into several capture groups by category. Several groups therefore share a scope. Group 10 is the concatenating tilde: a bare ~ concatenates when it sits between operands ($a ~ $b) and is bitwise not when it prefixes one (~$a), and trailing whitespace is the only thing that tells them apart, so it must be tried before group 14.",
          "captures": {
            "1": { "name": "keyword.operator.assignment.fenom" },
            "2": { "name": "keyword.operator.comparison.fenom" },
            "3": { "name": "keyword.operator.comparison.fenom" },
            "4": { "name": "keyword.operator.logical.fenom" },
            "5": { "name": "keyword.operator.bitwise.fenom" },
            "6": { "name": "keyword.operator.arithmetic.fenom" },
            "7": { "name": "keyword.operator.string.fenom" },
            "8": { "name": "keyword.operator.assignment.fenom" },
            "9": { "name": "keyword.operator.ternary.fenom" },
            "10": { "name": "keyword.operator.string.fenom" },
            "11": { "name": "keyword.operator.assignment.fenom" },
            "12": { "name": "keyword.operator.comparison.fenom" },
            "13": { "name": "keyword.operator.logical.fenom" },
            "14": { "name": "keyword.operator.bitwise.fenom" },
            "15": { "name": "keyword.operator.arithmetic.fenom" },
            "16": { "name": "keyword.operator.fenom" }
          },
          "match": "(<<=|>>=)|(===|!==)|(==|!=|<>|<=|>=)|(&&|\\|\\|)|(<<|>>)|(\\+\\+|--)|(~~)|(~=|\\|=|&=|\\^=|\\+=|-=|\\*=|/=|%=)|(\\?:|!:)|(~(?=\\s))|(=)|(<|>)|(!)|(\\||&|\\^|~)|(\\+|-|\\*|/|%)|(\\?|:|@)"
        },
        {
          "comment": "Test and containment operators. The compound forms are listed before their prefixes so that 'is not' does not match as a bare 'is'.",
          "match": "\\b(is\\s+not|not\\s+in|in\\s+list|in\\s+keys|in\\s+string|is|in)\\b",
          "name": "keyword.operator.comparison.fenom"
        },
        {
          "match": "\\b(and|or|xor)\\b",
          "name": "keyword.operator.logical.fenom"
        },
        {
          "comment": "Square brackets serve both index access ($foo[5], $foo['bar']) and array literals ([1, 2, 3]).",
          "match": "\\[",
          "name": "punctuation.section.brackets.begin.fenom"
        },
        {
          "match": "\\]",
          "name": "punctuation.section.brackets.end.fenom"
        },
        {
          "match": "\\b(TRUE|FALSE|true|false)\\b",
          "name": "constant.language.fenom"
        },
        {
          "match": "\\b(var|set|add|if|else|elseif|foreach|foreachelse|autoescape|autotrim|for|extends|block|use|paste|parent|filter|break|continue|forelse|ignore|include|insert|macro|import|raw|switch|case|unset|while|do|escape|strip)\\b",
          "name": "keyword.control.fenom"
        },
        {
          "captures": {
            "1": {
              "name": "variable.parameter.fenom"
            },
            "2": {
              "name": "keyword.operator.fenom"
            }
          },
          "match": "\\b([a-zA-Z]+)(=)",
          "name": "meta.attribute.fenom"
        },
        {
          "match": "\\b(plus|from|as|capture|default|cycle)\\b",
          "name": "support.function.built-in.fenom"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.fenom"
            }
          },
          "end": "'",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.fenom"
            }
          },
          "name": "string.quoted.single.fenom",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.fenom"
            }
          ]
        },
        {
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.fenom"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.fenom"
            }
          },
          "name": "string.quoted.double.fenom",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.fenom"
            }
          ]
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "match": "\\$_modx\\b",
          "name": "support.variable.fenom"
        },
        {
          "comment": "The unnamed system variable, $.get, $.const, $.tpl and so on. The accessor name is matched by shape rather than against Fenom's built-in list, because addAccessor() lets a project register its own and a fixed list would leave those unhighlighted.",
          "captures": {
            "1": {
              "name": "punctuation.definition.variable.fenom"
            },
            "2": {
              "name": "punctuation.accessor.fenom"
            },
            "3": {
              "name": "support.variable.fenom"
            }
          },
          "match": "(\\$)(\\.)([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "name": "variable.other.global.fenom"
        },
        {
          "comment": "A bare $. with no accessor after it.",
          "captures": {
            "1": {
              "name": "punctuation.definition.variable.fenom"
            },
            "2": {
              "name": "punctuation.accessor.fenom"
            }
          },
          "match": "(\\$)(\\.)",
          "name": "variable.other.global.fenom"
        },
        {
          "captures": {
            "1": {
              "name": "punctuation.definition.variable.fenom"
            }
          },
          "match": "(\\$)([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "name": "variable.other.fenom"
        },
        {
          "comment": "Iteration properties inside {foreach}. Compiler::foreachProp accepts index, first and last and raises a CompileException for anything else, so only those three are matched; an unknown one falls through to the plain @ operator.",
          "captures": {
            "1": {
              "name": "punctuation.accessor.fenom"
            },
            "2": {
              "name": "support.variable.property.fenom"
            }
          },
          "match": "(@)(index|first|last)\\b"
        },
        {
          "comment": "Dot access, as in $user.name and $.get.debug.",
          "captures": {
            "1": {
              "name": "punctuation.accessor.fenom"
            },
            "2": {
              "name": "variable.other.property.fenom"
            }
          },
          "match": "(\\.)([a-zA-Z_][a-zA-Z0-9_]*)\\b"
        },
        {
          "comment": "Dot access with a numeric key, as in $foo.5. The digits are left to the numbers rule.",
          "match": "\\.(?=\\d)",
          "name": "punctuation.accessor.fenom"
        },
        {
          "captures": {
            "1": {
              "name": "keyword.operator.fenom"
            },
            "2": {
              "name": "variable.other.property.fenom"
            }
          },
          "match": "(->)([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "name": "variable.other.fenom"
        },
        {
          "captures": {
            "1": {
              "name": "keyword.operator.fenom"
            },
            "2": {
              "name": "meta.function-call.object.fenom"
            },
            "3": {
              "name": "punctuation.definition.variable.fenom"
            },
            "4": {
              "name": "punctuation.definition.variable.fenom"
            }
          },
          "match": "(->)([a-zA-Z_][a-zA-Z0-9_]*)(\\().*?(\\))",
          "name": "variable.other.fenom"
        }
      ]
    }
  }
}
