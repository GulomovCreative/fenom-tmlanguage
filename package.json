{
  "name": "@gulomov/fenom-tmlanguage",
  "version": "2.0.1",
  "description": "TextMate grammar for the Fenom template engine, injected over HTML so markup, CSS and JavaScript keep their own highlighting",
  "author": {
    "name": "Gulomov Bakhtovar",
    "email": "gulomovcreative@gmail.com"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./fenom.tmLanguage.json": "./fenom.tmLanguage.json",
    "./language-configuration.json": "./language-configuration.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "fenom.tmLanguage.json",
    "language-configuration.json",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "npm run test:grammar && npm run test:snapshots && npm run test:nesting",
    "test:grammar": "node tests/grammar-file.test.mjs",
    "test:snapshots": "vscode-tmgrammar-snap -g fenom.tmLanguage.json -g tests/html-derivative.stub.tmLanguage.json -s text.html.fenom \"tests/**/*.tpl\"",
    "test:nesting": "node tests/nesting/nesting.test.mjs",
    "test:update": "npm run test:snapshots -- --updateSnapshot",
    "publish:major": "npm version major",
    "publish:minor": "npm version minor",
    "publish:patch": "npm version patch",
    "postversion": "git push && git push --tags && npm publish"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GulomovCreative/fenom-tmlanguage.git"
  },
  "keywords": [
    "fenom",
    "textmate",
    "tmlanguage",
    "grammar",
    "syntax-highlighting",
    "vscode",
    "template",
    "tpl"
  ],
  "license": "MIT",
  "devDependencies": {
    "shiki": "^4.4.3",
    "vscode-tmgrammar-test": "^0.1.3"
  }
}
